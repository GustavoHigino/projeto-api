{
  
  "Cors": {
    "Origins": [
      "http://localhost:3000",
      "http://localhost:8080",
      "https://erudio.com.br"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",//padrao é information
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "PrimeiroProjeto": "Debug" // configurando o log
        //do namespace se não o padrão é information
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
    
  },
  
  "AllowedHosts": "*"
}
